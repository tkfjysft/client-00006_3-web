---
import { getBlogs, getCategories } from "@/lib/microcms.ts";
import CategoryDetailTemplate from "@/components/templates/LowerTemplateBlogCategories.astro";

const currentUrl = Astro.url.pathname;

export async function getStaticPaths() {
  const response = await getCategories();
  
  return response.contents.map((category) => ({
    params: { category_slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const response = await getBlogs({
  filters: `category[equals]${category.id}`,
  fields: ["id", "title", "pubDate", "slug", "category"],
});
const posts = response.contents;
---

<CategoryDetailTemplate category={category} posts={posts} currentUrl={currentUrl} />