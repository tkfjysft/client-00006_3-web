---
import Layout from '@/layouts/Layout.astro';
import { resolveUrl } from '@/utils/pathHelper';
const currentUrl = Astro.url.pathname;
---

<Layout title="ページが見つかりませんでした | サイト名">


  <div class="wrap">
  <div class="max-w-4xl mx-auto px-6 py-30">
    <div class="bg-white/50 backdrop-blur-md border border-white/10 p-6 mb-16 md:p-8 rounded-3xl shadow-2xl">
    
            <!-- ステータスコード -->
      <p class="text-6xl md:text-8xl font-bold tracking-wider text-primary/80 mb-4">
        404
      </p>
    
      <h1 class="text-3xl font-serif mb-8">お探しのページが見つかりませんでした</h1>
    
      <p class="text-muted-foreground mb-8 leading-relaxed">
        指定されたURLが変更されたか、削除された可能性があります。
        お手数ですが、トップページより再度お探しください。
      </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={resolveUrl('/', currentUrl)}
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 rounded-full text-clr-wh-1 bg-clr-main-1 text-primary-foreground font-medium shadow-md hover:opacity-90 transition-opacity"
        >
          トップページへ戻る
        </a>
      </div>


  </div>
</div>
  </div>


</Layout>