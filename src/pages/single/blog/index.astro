---
// src/pages/blog/index.astro
import { getBlogs } from "@/lib/microcms.ts";

const response = await getBlogs({ fields: ["id", "title", "publishedAt"] });
const posts = response.contents;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>ブログ記事一覧</title>
  </head>
  <body>
    <main style="max-width: 600px; margin: 40px auto; font-family: sans-serif;">
      <h1>ブログ記事一覧</h1>
      
      <ul>
        {
          posts.map((post) => (
            <li style="margin-bottom: 16px;">
              <a href={`/blog/${post.id}`}>
                <h2>{post.title}</h2>
              </a>
              <p style="color: #666; font-size: 0.9rem;">
                公開日: {new Date(post.publishedAt).toLocaleString()}
              </p>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>