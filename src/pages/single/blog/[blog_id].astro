---
import { getBlogs, getBlogDetail } from "@/lib/microcms.ts";

// ① ビルド時に「どの記事ページを作るべきか」をAstroに教える関数
export async function getStaticPaths() {
  const response = await getBlogs({ fields: ["id"] });
  
  return response.contents.map((post) => ({
    params: { blog_id: post.id },
  }));
}

// ② URLから blog_id を受け取る
const { blog_id } = Astro.params;

// ③ microCMSから該当する記事のデータを取得
const post = await getBlogDetail(blog_id);
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>{post.title}</title>
  </head>
  <body>
    <main style="max-width: 600px; margin: 40px auto; font-family: sans-serif;">
      <!-- 一覧に戻るリンク -->
      <p style="margin-bottom: 24px;">
        <a href="/blog/">&lt; 記事一覧へ戻る</a>
      </p>

      <!-- ▼ 【追加】アイキャッチ画像があれば表示する -->
      {post.eyecatch && (
        <img 
          src={post.eyecatch.url} 
          alt="" 
          style="width: 100%; height: auto; border-radius: 8px; margin-bottom: 24px;" 
        />
      )}
      
      <!-- 記事タイトル -->
      <h1>{post.title}</h1>

      <!-- 公開日 -->
      <p style="color: #666; font-size: 0.9rem; margin-bottom: 32px;">
        公開日: {new Date(post.publishedAt).toLocaleString()}
      </p>

      <!-- 本文（microCMSのリッチエディタなどのHTML） -->
      <div class="post-content" set:html={post.content} />
    </main>
  </body>
</html>