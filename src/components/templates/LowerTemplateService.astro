---
// src/pages/multi/service.astro
import HeroSection from '@/components/common_lower_layer/HeroSection.astro';
import IntroSection from '@/components/service/IntroSection.astro';
import MenuSection from '@/components/service/MenuSection.astro';
import FlowSection from '@/components/service/FlowSection.astro';
import Layout from '@/layouts/Layout.astro';
import heroData from '@/components/service/heroSection.json';

interface Props {
  variant?: 'default' | 'rich';
}
const { 
  variant = 'default' 
} = Astro.props;
const isRich = variant === 'rich';
---
<Layout title={heroData.title} variant={variant}>
  <HeroSection title={heroData.title} subtitle={heroData.subtitle} variant={variant} />
  <IntroSection variant={variant} />
  <MenuSection variant={variant} />
  <FlowSection variant={variant} />
</Layout>