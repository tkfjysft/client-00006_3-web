	---
	import Layout from '@/layouts/Layout.astro';
	import Hero from '@/components/index/Hero/Hero.astro';
	import Greeting from '@/components/index/Greeting/Greeting.astro';
	import ServiceSection from '@/components/index/ServiceSection/ServiceSection.astro';
	import FlowSection from '@/components/index/FlowSection/FlowSection.astro';
	import TestimonialSection from '@/components/index/TestimonialSection/TestimonialSection.astro';
	import FaqSection from '@/components/index/FaqSection/FaqSection.astro';
	import ProfileSection from '@/components/index/ProfileSection/ProfileSection.astro';
	import BlogListSection from '@/components/index/BlogListSection/BlogListSection.astro';

	import { resolveUrl } from '@/utils/pathHelper';
	import { SITE_URLS } from '@/data/site';
	import FramerMotionSection from '@/components/FramerMotionSection.tsx';

	import { getBlogs } from '@/lib/microcms'; 

	interface Props {
		isSinglePage?: boolean; // ★ 単一ページかどうかのフラグに変更
		variant?: 'default' | 'rich'; // ← 追加：リッチ版の切り替え用プロパティ
	}

	const { isSinglePage = true, variant = 'default' } = Astro.props; // デフォルトは単一ページなど
	const currentPath = Astro.url.pathname;

	// 「単一ページでなければ（＝複数ページやプレミアムなら）ボタンを表示する」という判定
	const showDetailButton = !isSinglePage;
	const isRich = variant === 'rich';

	/* ▼ 追加：microCMSから最新の記事をいくつか取得する（例: 最新3件） */
		let posts = [];
		try {
		const response = await getBlogs({
			limit: 6,
			fields: ['id', 'title', 'pubDate', 'slug', 'category'],
		});
		posts = response.contents || [];
		} catch (error) {
		console.error("ブログ記事の取得に失敗しました:", error);
		}
	---

	<Layout title="トップページ" variant={variant}>
	<Hero variant={variant}  />
	<div class={isRich ? "" : "wrap"}>

{/* isRich が true のときだけ、クライアントサイドで動的にハイドレーションする */}
    {isRich && (
      <FramerMotionSection client:load />
    )}

	<Greeting variant={variant} />

	<ServiceSection
		isSinglePage={!showDetailButton}
		showDetailButton={showDetailButton}
		detailUrl={resolveUrl(SITE_URLS.SERVICE, currentPath)}
		variant={variant}
	/>

	<FlowSection
		isSinglePage={!showDetailButton}
		showDetailButton={showDetailButton}
		detailUrl={resolveUrl(SITE_URLS.SERVICE, currentPath)}
		variant={variant}
	/>

	<TestimonialSection
		isSinglePage={!showDetailButton}
		showDetailButton={showDetailButton}
		detailUrl={resolveUrl(SITE_URLS.VOICE, currentPath)}
		variant={variant}
	/>

	<FaqSection
		isSinglePage={!showDetailButton}
		showDetailButton={showDetailButton}
		detailUrl={resolveUrl(SITE_URLS.FAQ, currentPath)}
		variant={variant}
	/>

	<ProfileSection
		isSinglePage={!showDetailButton}
		showDetailButton={showDetailButton}
		detailUrl={resolveUrl(SITE_URLS.PROFILE, currentPath)}
		variant={variant}
	/>

	<BlogListSection
		posts={posts}
		currentUrl={currentPath}
		detailUrl={resolveUrl(SITE_URLS.BLOG, currentPath)}
		variant={variant}
	/>

	<section class="pt-200 bg-[#ffffff05]"></section>
	</div>
	</Layout>