---
import { resolveUrl } from '@/utils/pathHelper';
import Layout from '@/layouts/Layout.astro';
import SectionContainer from '@/components/common/SectionContainer.astro';
import HeroSection from '@/components/common_lower_layer/HeroSection.astro';
import type { Category, Blog } from '@/lib/microcms.ts';

	interface Props {
		category: Category;
  		posts: Blog[];
  		currentUrl: string;
		variant?: 'default' | 'rich'; // ← 追加：リッチ版の切り替え用プロパティ
	}

	const { category, posts, currentUrl, variant = 'default' } = Astro.props;

	const isRich = variant === 'rich';
---
<Layout title={`${category.name}の記事一覧`} variant={variant}>
  <HeroSection title={`${category.name} カテゴリの記事`} subtitle="ブログ" txtSizeName="text-2xl md:text-3xl" variant={variant} />
  
  <div class="wrap">
    <section class="py-20 bg-gradient-to-b from-clr-wh-1/60 via-clr-wh-1/40 to-clr-wh-1/10 text-clr-wh-1 min-h-screen">
      <SectionContainer>
        
        <!-- 一覧に戻るリンク -->
        <div
			class:list={[
				"mb-8 transition-all duration-2001 ease-out",
				isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
			]}
			style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
		>
          <a 
            href={resolveUrl('/blog/', currentUrl)}
            class="inline-flex items-center gap-2 text-base text-clr-main-1 hover:text-clr-main-1/80 transition-colors duration-200 group"
          >
            <span class="transform group-hover:-translate-x-1 transition-transform duration-200">&lt;</span>
            <span>ブログ一覧へ戻る</span>
          </a>
        </div>

        <!-- 記事一覧のループ -->
        <div class="grid gap-6">
          {posts.length === 0 ? (
            <p>このカテゴリの記事はまだありません。</p>
          ) : (
            posts.map((post: any) => {
              const postSlug = post.slug || post.id;
              return (
                <article
					class:list={[
						"p-6 bg-white/50 rounded-lg shadow-sm transition-all duration-2001 ease-out",
						isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
						]}
						style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
						>
                  <time datetime={post.pubDate} class="text-sm text-gray-500 mr-2">
                    {new Date(post.pubDate).toLocaleDateString('ja-JP', {
                      year: 'numeric',
                      month: '2-digit',
                      day: '2-digit'
                    })}
                  </time>

                  {post.category && (
                    <span class="inline-block px-2.5 py-0.5 bg-clr-main-1/10 text-clr-main-1 text-xs rounded-md font-bold mb-2">
                      {post.category.name}
                    </span>
                  )}
                  <h2 class="text-xl font-bold mb-2">
                    <a href={resolveUrl(`/blog/${postSlug}/`, currentUrl)} class="hover:text-clr-main-1 transition-colors">
                      {post.title}
                    </a>
                  </h2>
                </article>
              );
            })
          )}
        </div>

      </SectionContainer>
    </section>
  </div>
</Layout>