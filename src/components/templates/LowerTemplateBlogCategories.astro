---
import { resolveUrl } from '@/utils/pathHelper';
import Layout from '@/layouts/Layout.astro';
import SectionContainer from '@/components/common/SectionContainer.astro';
import HeroSection from '@/components/common_lower_layer/HeroSection.astro';
import type { Category, Blog } from '@/lib/microcms.ts';

    interface Props {
        category: Category;
        posts: Blog[];
        currentUrl: string;
        variant?: 'default' | 'rich'; // ← 追加：リッチ版の切り替え用プロパティ
    }

    const { category, posts, currentUrl, variant = 'default' } = Astro.props;

    const isRich = variant === 'rich';
---
<Layout title={`${category.name}の記事一覧`} variant={variant}>
  <HeroSection title={`${category.name} カテゴリの記事`} subtitle="ブログ" txtSizeName="text-2xl md:text-3xl" variant={variant} />
  
  <div class="wrap">
    <section class="py-20 bg-gradient-to-b from-clr-wh-1/60 via-clr-wh-1/40 to-clr-wh-1/10 text-clr-wh-1 min-h-screen">
      <SectionContainer>
        
        <!-- 一覧に戻るリンク -->
        <div
            class:list={[
                "mb-8 transition-all duration-2001 ease-out",
                isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
            ]}
            style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
        >
          <a 
            href={resolveUrl('/blog/', currentUrl)}
            class="inline-flex items-center gap-2 text-base text-clr-main-1 hover:text-clr-main-1/80 transition-colors duration-200 group"
          >
            <span class="transform group-hover:-translate-x-1 transition-transform duration-200">&lt;</span>
            <span>ブログ一覧へ戻る</span>
          </a>
        </div>

        <!-- 記事一覧のループ -->
        <div class="grid gap-6">
          {posts.length === 0 ? (
            <p class="text-clr-bl-1">このカテゴリの記事はまだありません。</p>
          ) : (
            posts.map((post: any) => {
              const postSlug = post.slug || post.id;
              const eyecatchUrl = post.eyecatch?.url;

              return (
                <article
                    class:list={[
                        "relative p-6 md:p-8 bg-gradient-to-b from-clr-wh-1/85 via-clr-wh-1/70 to-clr-wh-1/20 border border-clr-main-1/40 hover:border-clr-accent/60 rounded-2xl shadow-lg transition-all duration-300 group overflow-hidden",
                        isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
                    ]}
                    style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
                >
                  <div class="flex flex-col md:flex-row items-stretch gap-6 md:gap-8">
                    
                    {/* --- サムネイル画像エリア --- */}
                    {eyecatchUrl && (
                      <div class="w-full md:w-56 shrink-0 aspect-video md:aspect-[4/3] rounded-xl overflow-hidden bg-clr-main-1/5">
                        <img 
                          src={eyecatchUrl} 
                          alt={post.title}
                          loading="lazy"
                          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                      </div>
                    )}

                    {/* --- テキストコンテンツエリア --- */}
                    <div class="flex flex-col flex-grow justify-between">
                      <div>
                        {/* メタ情報（日付・カテゴリ） */}
                        <div class="flex items-center gap-3 mb-3">
                          {post.pubDate && (
                            <time datetime={post.pubDate} class="text-xs font-bold text-clr-bl-1/70">
                              {new Date(post.pubDate).toLocaleDateString('ja-JP', {
                                year: 'numeric',
                                month: '2-digit',
                                day: '2-digit'
                              })}
                            </time>
                          )}
                          {post.category && (
                            <span class="relative z-20 px-2.5 py-0.5 bg-clr-main-1/10 text-clr-main-1 text-xs rounded-md font-bold">
                              {post.category.name}
                            </span>
                          )}
                        </div>

                        {/* 記事タイトル ＆ 全体リンク */}
                        <h2 class="txt-luster text-lg md:text-xl font-serif font-bold text-clr-bl-1 group-hover:text-clr-main-1 transition-colors duration-200">
                          <a href={resolveUrl(`/blog/${postSlug}/`, currentUrl)} class="focus:outline-none">
                            <span class="absolute inset-0 z-10"></span>
                            {post.title}
                          </a>
                        </h2>
                      </div>

                      {/* 矢印アイコン */}
                      <div class="flex justify-end items-center gap-2 text-xl font-bold text-clr-main-1 mt-4 md:mt-0">
                        <span class="txt-luster transform group-hover:translate-x-1 transition-transform duration-200">記事を読む →</span>
                      </div>
                    </div>

                  </div>
                </article>
              );
            })
          )}
        </div>

      </SectionContainer>
    </section>
  </div>
</Layout>