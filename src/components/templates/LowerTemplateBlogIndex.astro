---
import Layout from '@/layouts/Layout.astro';
import SectionContainer from '@/components/common/SectionContainer.astro';
import HeroSection from '@/components/common_lower_layer/HeroSection.astro';

// import heroData from '@/components/profile/heroSection.json';

import { getBlogs } from "@/lib/microcms.ts";
import { resolveUrl } from '@/utils/pathHelper';

const currentUrl = Astro.url.pathname;

const response = await getBlogs({ fields: ["id", "title", "pubDate", "slug", "category"] });
const posts = response.contents;

	interface Props {
	variant?: 'default' | 'rich'; // ← 追加：リッチ版の切り替え用プロパティ
	}

	const { variant = 'default' } = Astro.props; // デフォルトは単一ページなど


	const isRich = variant === 'rich';
---

<Layout title="ブログ記事一覧" variant={variant}>
	<HeroSection title="ブログ" subtitle="記事一覧" variant={variant} />
  <section class="py-20 bg-gradient-to-b from-clr-base-1/30 via-clr-bl-1/30 to-clr-base-1/30 text-clr-wh-1 min-h-screen">
    <SectionContainer>
      <div class="max-w-4xl mx-auto px-6">

        <!-- 記事リスト（カード形式） -->
        <ul class="space-y-10">
{
  posts.map((post) => {
    // slugがあればslugを優先、なければ従来のidを使う
    const postSlug = post.slug || post.id;

    return (
		<li
		class:list={[
        "relative transition-all duration-2001 ease-out",
        isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
		]}
		style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
		>

				  
                  <article class="flex flex-col md:flex-row md:items-center md:justify-between gap-8 rounded-2xl p-6 md:p-8 bg-gradient-to-b from-clr-wh-1/85 via-clr-wh-1/70 to-clr-wh-1/20 border border-clr-main-1/40 hover:border-clr-accent/60 transition-all duration-300 shadow-lg group">

				  <div>
					{/* --- ここからカテゴリバッジを追加 --- */}
      {post.category && (
        <div class="mb-2">
          <a 
            href={resolveUrl(`/blog/category/${post.category.slug}/`, currentUrl)}
            class=" px-2.5 py-0.5 bg-clr-main-1/10 text-clr-main-1 text-xs rounded-md font-bold hover:bg-clr-main-1/20 transition-colors"
          >
            {post.category.name}
          </a>
        </div>
      )}
      {/* --- ここまで --- */}

	  

					<div class="txt-luster flex items-center gap-2 text-base font-bold text-clr-main-1 shrink-0">
                      <time datetime={post.pubDate}>
                        {new Date(post.pubDate).toLocaleDateString('ja-JP', {
                          year: 'numeric',
                          month: '2-digit',
                          day: '2-digit'
                        })}
                      </time>
                    </div>
				  </div>

	  			<a href={resolveUrl(`/blog/${postSlug}/`, currentUrl)} >

                    <div class="space-y-2">
                      <h2 class="txt-luster text-lg md:text-xl font-serif font-bold text-clr-bl-1 group-hover:text-clr-main-1/70 transition-colors duration-200">
                        {post.title}
                      </h2>
                    </div>
                    									</a>

                    <div class="flex justify-end items-center gap-2 text-2xl font-bold text-clr-main-1 shrink-0">
                      <span class="txt-luster transform group-hover:translate-x-1 transition-transform duration-200">→</span>
                    </div>
                  </article>
			</li>
				);
			})
			}   
     </ul>

      </div>
    </SectionContainer>
  </section>
</Layout>