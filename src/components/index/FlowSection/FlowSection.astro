---
import { getEntry } from 'astro:content';
import SectionContainer from '@/components/common/SectionContainer.astro';
import { Image } from 'astro:assets';
import lineBright from '@/assets/images/line_bright.avif';

import flowData from './flow.json';
const { title, steps, summaryTitle, summary } = flowData;

import { BASE_NAV_ITEMS } from '@/data/site';

// 1. HomeTemplate からプロパティを受け取る定義を追加
interface Props {
  showDetailButton?: boolean;
  detailUrl?: string;
  isSinglePage?: boolean;
  variant?: 'default' | 'rich';
}

const { 
  showDetailButton = false, 
  detailUrl = '#', 
  isSinglePage = true,
  variant = 'default' 
} = Astro.props;

const isRich = variant === 'rich';

import DetailButton from '@/components/common/DetailButton.astro';
---

<section class="section-margin-y py-24 md:py-32 text-clr-wh-1 relative overflow-hidden">
  <SectionContainer>
	<div 
      class:list={[
        "relative mb-20 transition-all duration-2001 ease-out",
        isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
      ]}
      style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
    >
      <Image 
        src={lineBright} 
        alt="サブタイトル背景" 
        width={713} 
        height={245}
        class="absolute inset-0 top-[50%] left-[50%] -translate-x-1/2 -translate-y-1/2 z-[-1] w-[100vw] pointer-events-none backface-hidden"
        style="will-change: transform; transform: translateZ(0);"
        aria-hidden="true"
      />  
      <h2 class="txt-luster [text-shadow:_0_0_30px_white] text-3xl text-center md:text-6xl font-serif text-clr-main-1 sm:tracking-widest mb-6">
        {title}
      </h2>
    </div>  


	<!-- <p class="text-clr-bl-1 text-lg max-w-lg mx-auto leading-relaxed bg-white/50 backdrop-blur-md border border-white/10 p-6 mb-16 md:p-8 rounded-3xl shadow-2xl">{description}</p> -->

    {/* PC時はグリッドで等間隔に配置し、線を中央に通す */}
    <div 
      class:list={[
        "grid md:grid-cols-4 gap-8 relative mx-auto leading-relaxed bg-white/50 backdrop-blur-md border border-white/10 p-6 mb-16 md:p-8 rounded-3xl shadow-2xl transition-all duration-2001 ease-out",
        isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
      ]}
      style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
	>
      {/* 連結線：PC時のみ、grid全体の中央を通す */}
      <div class="hidden md:block absolute top-16 left-[12.5%] right-[12.5%] h-px border-t border-dashed border-clr-main-1/30"></div>

      {steps.map((item, index) => {
        const romanNumbers = ["I", "II", "III", "IV"];
        
        return (

		<div 
            class:list={[
              "relative flex flex-col items-center text-center group z-10 transition-all duration-1200 ease-out",
              isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
            ]}
            style={isRich ? `transition-delay: ${index * 0.2}s;` : undefined}
          >


            {/* ステップ番号：背景色の指定により線が背後を通るようにする */}
            <div class="w-16 h-16 border border-clr-main-1 flex items-center justify-center text-2xl font-serif text-clr-wh-1 mb-6 bg-clr-base-1 group-hover:bg-clr-main-1 transition-all duration-500">
              {romanNumbers[index] || item.step}
            </div>
            
            <h3 class="text-xl font-serif text-clr-main-1 mb-4">
              {item.name}
            </h3>
            
            {/* 説明文のみ左寄せ */}
            <p class="text-base text-clr-bl-1 leading-relaxed text-left w-full max-w-[240px]">
              {item.description}
            </p>
          </div>
        );
      })}
    </div>

	{isSinglePage && (
      <div class="my-12 text-clr-wh-1 text-lg mx-auto leading-relaxed bg-clr-main-1/50 backdrop-blur-md border border-white/10 p-6 mb-16 md:p-8 rounded-3xl shadow-2xl">
        <h3 class="text-2xl text-clr-wh-1 font-bold mb-4">{summaryTitle}</h3>
        <p>{summary}</p>
      </div>
    )}

	{showDetailButton && (
    <DetailButton href={detailUrl} text={BASE_NAV_ITEMS[1].text} />
  	)}


  </SectionContainer>
</section>