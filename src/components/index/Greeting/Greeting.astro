---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_INFO } from '@data/site';
import SectionContainer from '@/components/common/SectionContainer.astro';

import greetingData from './greeting.json';

interface Props {
  variant?: 'default' | 'rich';
}

const { variant = 'default' } = Astro.props;
const isRich = variant === 'rich';

const content = greetingData.content.replace('{NAME}', SITE_INFO.ownerName);
const { title } = greetingData;
---

<section class="relative py-24 overflow-hidden mt-[50vh]">
  <SectionContainer class="section-margin-y flex flex-col items-center relative z-10">
    <div 
      class:list={[
        /* 
          【調整ポイント2】
          - duration-1000 から duration-1200（1.2秒）にして、よりゆったりと上品な余韻に
          - 最初の位置を translate-y-12 に少し深くして、動く距離をしっかり感じさせる
        */
        "p-6 md:p-8 rounded-3xl shadow-2xl transition-all duration-1500 ease-out text-base md:text-lg",
        isRich 
          ? "demo03-fade-target transform translate-y-30 opacity-0 bg-clr-wh-1/50 backdrop-blur-xl text-clr-bl-1 shadow-clr-main-1/10" 
          : "bg-clr-wh-1/50 backdrop-blur-md border border-clr-wh-1/10 text-clr-bl-1"
      ]}
    >

      <div class="max-w-3xl space-y-10">
        <h2 class:list={[
          "text-2xl md:text-3xl font-serif tracking-widest uppercase text-center",
          isRich ? "text-clr-main-1" : "text-clr-main-1"
        ]}>
          {title}
        </h2>
        
        <div class="max-w-2xl mx-auto space-y-6">
          <p class:list={[
            "font-serif text-base md:text-lg leading-loose whitespace-pre-line text-left opacity-90",
            isRich ? "text-clr-bl-1" : "text-clr-bl-1"
          ]}>
            {content}
          </p>
        </div>

        <div class="flex justify-center pt-4">
          <div class:list={[
            "w-24 h-px",
            isRich ? "bg-clr-accent" : "bg-clr-main-1"
          ]}></div>
        </div>
      </div>

    </div>
  </SectionContainer>
</section>

{isRich && (
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observerOptions = {
        root: null,
        /* 
          【調整ポイント1】
          - rootMargin を調整して、画面の下端ではなく「もう少し上（画面の中央寄り）」に入ってきたら発火するようにする
          - 下から -15% の位置をラインにして、そこを通過した瞬間にアニメーション開始
        */
        rootMargin: '0px 0px -15% 0px',
        threshold: 0.2, // 20%以上が見えたら
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-12');
            entry.target.classList.add('opacity-100', 'translate-y-0');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      const targets = document.querySelectorAll('.demo03-fade-target');
      targets.forEach((target) => observer.observe(target));
    });
  </script>
)}