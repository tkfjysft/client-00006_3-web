---
import { SITE_INFO } from '@/data/site';
const profileData = SITE_INFO.profile;
import profileImage from '@/assets/images/owner/face_owner.avif';
import ChannelingImage from '@/assets/images/owner/channeling_owner.avif';

import SectionContainer from '@/components/common/SectionContainer.astro';
import { Image } from 'astro:assets';
import leftTopFrame from '@/assets/images/radiance.avif';

// タイトルを「：」で分割する処理
const titleParts = profileData.title ? profileData.title.split('：') : ['プロフィール'];
const hasColon = titleParts.length > 1;
---

<section class="py-20 bg-gradient-to-b from-clr-wh-1/50 via-clr-bl-1/50 to-clr-base-1/50 text-clr-wh-1">
  <SectionContainer>
    <div class="max-w-4xl mx-auto px-6">
      
      <!-- 見出しセクション -->
      <h2 class="txt-shadow-2 text-3xl md:text-4xl font-bold text-center mb-6 text-clr-wh-1 leading-relaxed">
        {hasColon ? (
          <>
            <span class="block text-xl md:text-2xl font-normal mb-2 text-clr-wh-1">{titleParts[0]}：</span>
            <span>{titleParts[1]}</span>
          </>
        ) : (
          profileData.title
        )}
      </h2>

	  
      {profileData.subtitle && (
        <p class="txt-shadow-2 text-center text-clr-accent mb-16 text-lg md:text-xl font-serif font-bold tracking-wide">
          {profileData.subtitle}
        </p>
      )}


      <div class="flex flex-col items-center gap-10 sm:flex-row sm:justify-between sm:gap-0 mx-auto mb-10">
        <Image 
          src={profileImage} 
          alt={SITE_INFO.ownerName} 
          class="shadow-2xl w-full sm:w-[40vw] max-w-[400px] aspect-[4/5] object-cover brightness-90 border border-clr-main-1/20" 
        />
		 <Image 
          src={ChannelingImage} 
          alt={SITE_INFO.ownerName} 
          class="shadow-2xl w-full sm:w-[40vw] max-w-[400px] aspect-[4/5] object-cover brightness-90 border border-clr-main-1/20" 
        />
      </div>


      <!-- メインプロフィールカード（お名前・リード文・タグ） -->
      <div class="relative rounded-3xl p-8 md:p-12 bg-clr-base-1/90 border border-clr-main-1/40 shadow-xl overflow-hidden mb-12">
        
        <!-- あしらい画像（光の演出） -->
        <Image 
          src={leftTopFrame} 
          alt="あしらい" 
          width={220} 
          height={180}
          class="absolute top-0 left-0 -translate-x-1/3 -translate-y-1/3 mix-blend-screen pointer-events-none backface-hidden"
          style="will-change: transform; transform: translateZ(0);"
          aria-hidden="true"
        />

        <div class="relative z-10">
          <div class="flex flex-col md:flex-row md:items-center gap-4 mb-8 pb-6 border-b border-clr-wh-1/15">
            <span class="text-sm font-bold text-clr-wh-1 bg-clr-accent px-4 py-1.5 rounded-full w-fit">
              スピリチュアルリーダー
            </span>
            <h3 class="text-3xl md:text-4xl font-serif font-bold text-clr-wh-1">
              {SITE_INFO.ownerName} <span class="text-base md:text-lg font-normal text-clr-main-2 ml-2">- {SITE_INFO.ownerNameEn} -</span>
            </h3>
          </div>

          {profileData.lead && (
            <p class="text-clr-wh-1 text-lg leading-relaxed mb-6 font-medium">
              {profileData.lead}
            </p>
          )}

          <div class="space-y-6 text-clr-wh-1/90 text-base leading-relaxed whitespace-pre-line mb-8">
            {profileData.text}
          </div>

          <!-- タグ一覧 -->
          <div class="flex flex-wrap gap-2 pt-4 border-t border-clr-wh-1/15">
            {profileData.tags.map((tag) => (
              <span class="text-base text-clr-main-2 bg-clr-main-1/40 border border-clr-main-2/30 px-4 py-1.5 rounded-full">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- 理念セクション (philosophy) -->
      {profileData.philosophy && (
        <div class="rounded-3xl p-8 md:p-10 bg-clr-main-1/50 border border-clr-main-2/30 mb-12">
          <h4 class="txt-shadow-2 text-xl md:text-2xl font-serif font-bold text-clr-accent mb-4">
            {profileData.philosophy.title}
          </h4>
          <p class="txt-shadow-2 text-lg md:text-xl font-bold text-clr-wh-1 mb-4">
            {profileData.philosophy.concept}
          </p>
          <p class="txt-shadow-2 text-base text-clr-wh-1/90 leading-relaxed">
            {profileData.philosophy.description}
          </p>
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <!-- 経歴・歩みセクション (history) -->
        {profileData.history && (
          <div class="rounded-3xl p-8 bg-clr-base-1/80 border border-clr-main-1/30 flex flex-col justify-between">
            <div>
              <h4 class="text-xl font-serif font-bold text-clr-accent mb-6">これまでの歩み</h4>
              <div class="space-y-6">
                {profileData.history.map((item) => (
                  <div class="border-l-2 border-clr-main-2 pl-4 py-1">
                    <span class="text-sm font-bold text-clr-main-2 block mb-1">{item.period}</span>
                    <p class="text-base text-clr-wh-1/90 leading-relaxed">{item.event}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        <!-- 得意なアプローチ (specialties) -->
        {profileData.specialties && (
          <div class="rounded-3xl p-8 bg-clr-base-1/80 border border-clr-main-1/30 flex flex-col justify-between">
            <div>
              <h4 class="text-xl font-serif font-bold text-clr-accent mb-6">得意なテーマ・アプローチ</h4>
              <ul class="space-y-4">
                {profileData.specialties.map((specialty) => (
                  <li class="flex items-start gap-3 text-base text-clr-wh-1/90 leading-relaxed">
                    <span class="text-clr-accent font-bold mt-0.5">✓</span>
                    <span>{specialty}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </div>

      <!-- メッセージ (message) -->
      {profileData.message && (
        <div class="rounded-3xl p-8 md:p-10 bg-gradient-to-b from-clr-base-1 via-clr-bl-1 to-clr-main-1 border border-clr-accent/10 text-center shadow-lg">
          <h4 class="text-xl font-serif font-bold text-clr-accent mb-4">あなたへ贈るメッセージ</h4>
          <p class="text-base md:text-lg text-clr-wh-1 leading-relaxed max-w-2xl mx-auto">
            {profileData.message}
          </p>
        </div>
      )}

    </div>
  </SectionContainer>
</section>