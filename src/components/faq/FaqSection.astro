---
import faqData from './faqSection.json';
import SectionContainer from '@/components/common/SectionContainer.astro';

const titleParts = faqData.title.split('：');
const hasColon = titleParts.length > 1;
---

<section class="py-20 bg-clr-wh-1/70">
  <SectionContainer>
    <div class="max-w-4xl mx-auto px-6">
      <!-- 見出しセクション -->
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-6 text-clr-base-1 leading-relaxed">
        {hasColon ? (
          <>
            <span class="block text-xl md:text-3xl font-normal mb-2 text-clr-main-1">{titleParts[0]}：</span>
            <span>{titleParts[1]}</span>
          </>
        ) : (
          faqData.title
        )}
      </h2>
      <p class="txt-luster text-left text-clr-bl-1 mb-16 max-w-2xl mx-auto text-base leading-relaxed">{faqData.description}</p>

      <!-- FAQリスト（すっきりしたアコーディオン形式） -->
      <div class="flex flex-col gap-8">
        {faqData.questions.map((item, index) => (
          <details class="group relative rounded-2xl bg-clr-wh-1/90 border border-clr-main-2/40 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">
            
            <!-- 開閉ボタン部分 -->
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
              <div class="flex items-center gap-4 pr-4">
                <span class="text-base font-bold text-clr-main-1 bg-clr-main-2/25 w-10 h-10 rounded-full flex items-center justify-center shrink-0">
                  Q{index + 1}
                </span>
                <span class="text-base md:text-lg font-bold text-clr-base-1 leading-snug">
                  {item.q}
                </span>
              </div>
              
              <!-- 開閉アイコン（回転アニメーション） -->
              <div class="w-8 h-8 rounded-full bg-clr-main-2/20 flex items-center justify-center shrink-0 transition-transform duration-300 group-open:rotate-180">
                <svg class="w-4 h-4 text-clr-main-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </summary>

            <!-- 回答エリア -->
            <div class="px-6 pb-6 pt-2 bg-clr-main-2/5 border-t border-clr-main-2/20">
              <div class="flex items-start gap-4 pt-2">
                <span class="text-base font-bold text-clr-base-1 bg-clr-accent w-10 h-10 rounded-full flex items-center justify-center shrink-0 shadow-sm">
                  A
                </span>
                <p class="text-clr-bl-1 text-base leading-relaxed pt-2">
                  {item.a}
                </p>
              </div>
            </div>

          </details>
        ))}
      </div>
    </div>
  </SectionContainer>
</section>