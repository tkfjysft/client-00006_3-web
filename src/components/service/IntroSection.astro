---
import introData from './introSection.json';
import SectionContainer from '@/components/common/SectionContainer.astro';

interface Props {
  variant?: 'default' | 'rich';
}
const { 
  variant = 'default' 
} = Astro.props;
const isRich = variant === 'rich';
---

<section class="py-20 bg-clr-wh-1/90">
	<SectionContainer>
	<div
	    class:list={[
        "max-w-4xl mx-auto px-6"
      ]}
	>
		<!-- 導入見出し -->
		<h2
		class:list={[
        "text-3xl md:text-4xl font-bold text-clr-bl-1 text-center mb-10 leading-tight transition-all duration-2001 ease-out",
        isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
		]}
		style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
		>
		{introData.heading}
		</h2>
		
		<!-- リード文 -->
		<p
		class:list={[
        "text-lg md:text-xl text-clr-bl-1/80 leading-relaxed mb-16 text-center transition-all duration-2001 ease-out",
        isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
		]}
		style={isRich ? `will-change: transform; transition-delay: 0.1s;` : undefined}
		>
		{introData.leadText}
		</p>

		<!-- 特徴グリッド -->
		<div class="grid md:grid-cols-3 gap-8">
		{introData.features.map((item, index) => (
			<div
			class:list={[
              "p-6 border border-clr-bl-1/10 rounded-2xl hover:border-clr-main-2 transition-all duration-1200 ease-out",
              isRich ? "demo03-fade-target transform translate-y-20 opacity-0" : ""
            ]}
            style={isRich ? `transition-delay: ${index * 0.2}s;` : undefined}
			>
			<h3 class="text-xl font-semibold text-clr-main-1 mb-4">{item.title}</h3>
			<p class="text-clr-bl-1/70 leading-relaxed">{item.description}</p>
			</div>
		))}
		</div>
	</div>
	</SectionContainer>
</section>