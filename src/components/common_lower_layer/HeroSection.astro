---
interface Props {
  title: string;
  subtitle: string;
  class?: string;
  txtSizeName?: string;
}

const { 
  title, 
  subtitle, 
  class: defaultClass = "text-4xl md:text-5xl",
  txtSizeName,
} = Astro.props;

const currentTextSize = txtSizeName || defaultClass;
---

<!-- 
  bg-clr-base-1: 背景色として適用
-->
<section class="relative bg-clr-base-1/60 pb-24 pt-20 sm:pt-28">
  
  <!-- コンテンツエリア -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class={`font-extrabold text-clr-wh-1 tracking-tight ${currentTextSize}`}>
      {title}
    </h1>
    <p class="mt-6 text-xl text-clr-wh-1/80 max-w-3xl mx-auto leading-relaxed">
      {subtitle}
    </p>
  </div>
</section>