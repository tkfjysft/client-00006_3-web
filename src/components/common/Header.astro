---
import { NAV_ITEMS, SITE_INFO, PLANS } from '@data/site';
import * as Lucide from 'lucide-astro';
import Link from '@/components/common/Link.astro';
import SectionContainer from '@/components/common/SectionContainer.astro';
import DrawerMenu from '@/components/common/DrawerMenu.astro';


import { resolveUrl } from '@/utils/pathHelper';
import { Image } from 'astro:assets';
import headerCiLogo from '@/assets/images/logo_yukissession.avif';

const getIcon = (name: string) => {
  return Lucide[name as keyof typeof Lucide];
};
const currentUrl = Astro.url.pathname;

const segments = Astro.url.pathname.split('/');
const currentPlan = segments[1];

// 3つのプランに応じてナビゲーションを切り替え
const navItems = 
  currentPlan === PLANS.PREMIUM ? NAV_ITEMS.premium :
  currentPlan === PLANS.MULTI ? NAV_ITEMS.multi : 
  NAV_ITEMS.single; // デフォルト（demo-a）

import { BASE_NAV_ITEMS } from '@/data/site'; // ナビデータのインポート例

const currentPath = Astro.url.pathname;
  
---

<header class="fixed w-full h-16 sm:h-20 z-50 bg-clr-wh-1/30">

<SectionContainer class="relative z-10" py="py-0">

  <div class="flex items-center justify-between mx-auto py-4 h-16 sm:h-20">
    <!-- <div class="txt-luster text-3xl lg:text-[2.5vw] xl:text-4xl font-serif font-bold text-clr-bl-1"><Link href={resolveUrl('/', currentUrl)}>{SITE_INFO.title}</Link></div> -->
    
    <div class="w-[200px] sm:w-[30vw] lg:w-[18vw] h-full flex items-center">
		<Link href={resolveUrl('/', currentUrl)}>
				<Image 
		src={headerCiLogo} 
		alt={SITE_INFO.title}
		width={330} 
		height={94}
    />  

	
		<!-- <img
		src={`@/assets/images/${SITE_INFO.titleLogoImage}`}
		alt={SITE_INFO.title}
		width="300"
		height="63"
		/> -->
	</Link>
	</div>


    <nav class="hidden lg:flex gap-6">
      {navItems.map((item) => {
          const Icon = getIcon(item.icon);
          return (
            <Link href={resolveUrl(item.url, currentUrl)} class="txt-luster flex items-center gap-2 font-bold text-base text-clr-bl-1 hover:text-clr-bl-1/70 transition-colors tracking-[-0.01em]">
              {/* {Icon && <Icon class="w-4 h-4 text-clr-accent-1" />} */}
              <span>{item.text}</span>
            </Link>
          );
        })}
    </nav>
	

<DrawerMenu navItems={navItems} currentUrl={currentPath} />


  </div>

</SectionContainer>
</header>